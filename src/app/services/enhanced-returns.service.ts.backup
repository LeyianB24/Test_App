import { Injectable, inject, signal, computed } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { TaxReturn, SearchFilters, PaginationInfo, ApiResponse } from '../models/enhanced.models';
import { Observable, of } from 'rxjs';
import { tap, map, catchError } from 'rxjs/operators';

@Injectable({
  providedIn: 'root'
})
export class EnhancedReturnsService {
  private http = inject(HttpClient);
  private apiUrl = 'http://localhost/itax/kra-api/return_actions.php';
  
  // Signals for reactive state management
  private returns = signal<TaxReturn[]>([]);
  private loading = signal(false);
  private error = signal<string | null>(null);
  private pagination = signal<PaginationInfo>({
    currentPage: 1,
    totalPages: 1,
    totalItems: 0,
    itemsPerPage: 10,
    hasNext: false,
    hasPrevious: false
  });
  
  // Computed values
  allReturns = computed(() => this.returns());
  isLoading = computed(() => this.loading());
  errorMessage = computed(() => this.error());
  paginationInfo = computed(() => this.pagination());
  
  // Filtered computed values
  draftReturns = computed(() => 
    this.returns().filter(r => r.status === 'draft')
  );
  submittedReturns = computed(() => 
    this.returns().filter(r => r.status === 'submitted')
  );
  acceptedReturns = computed(() => 
    this.returns().filter(r => r.status === 'accepted')
  );
  rejectedReturns = computed(() => 
    this.returns().filter(r => r.status === 'rejected')
  );
  amendedReturns = computed(() => 
    this.returns().filter(r => r.status === 'amended')
  );
  
  // Statistics
  totalTaxPayable = computed(() => 
    this.returns().reduce((sum, r) => sum + r.tax_payable, 0)
  );
  totalTaxPaid = computed(() => 
    this.returns().reduce((sum, r) => sum + r.tax_paid, 0)
  );
  totalPenalties = computed(() => 
    this.returns().reduce((sum, r) => sum + r.penalty, 0)
  );
  totalRefunds = computed(() => 
    this.returns().reduce((sum, r) => sum + r.refund, 0)
  );
  totalReturnsCount = computed(() => this.returns().length);
  draftCount = computed(() => this.draftReturns().length);
  submittedCount = computed(() => this.submittedReturns().length);
  acceptedCount = computed(() => this.acceptedReturns().length);
  rejectedCount = computed(() => this.rejectedReturns().length);

  constructor() {
    this.loadReturns();
  }

  // ========== CRUD Operations ==========
  
  loadReturns(filters?: SearchFilters): Observable<ApiResponse<TaxReturn[]>> {
    this.loading.set(true);
    this.error.set(null);
    
    const params = this.buildQueryParams(filters);
    
    return this.http.get<any>(`${this.apiUrl}?${params}`).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          this.returns.set(response.data || []);
          if (response.pagination) {
            this.pagination.set(response.pagination);
          }
        } else {
          this.error.set(response.message || 'Failed to load returns');
        }
      }),
      map(response => response as ApiResponse<TaxReturn[]>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to connect to server');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  createReturn(returnData: Partial<TaxReturn>): Observable<ApiResponse<TaxReturn>> {
    this.loading.set(true);
    
    const payload = {
      ...returnData,
      return_reference: this.generateReturnReference(),
      status: 'draft',
      created_at: new Date().toISOString()
    };

    return this.http.post<any>(this.apiUrl, payload).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          // Refresh the return list
          this.loadReturns();
        } else {
          this.error.set(response.message || 'Failed to create return');
        }
      }),
      map(response => response as ApiResponse<TaxReturn>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to create return');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  updateReturn(id: number, updates: Partial<TaxReturn>): Observable<ApiResponse<TaxReturn>> {
    this.loading.set(true);
    
    return this.http.put<any>(`${this.apiUrl}?id=${id}`, updates).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          // Update local state
          const currentReturns = this.returns();
          const updatedReturns = currentReturns.map(taxReturn => 
            taxReturn.id === id ? { ...taxReturn, ...updates } : taxReturn
          );
          this.returns.set(updatedReturns);
        } else {
          this.error.set(response.message || 'Failed to update return');
        }
      }),
      map(response => response as ApiResponse<TaxReturn>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to update return');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  deleteReturn(id: number): Observable<ApiResponse<boolean>> {
    this.loading.set(true);
    
    return this.http.delete<any>(`${this.apiUrl}?id=${id}`).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          // Remove from local state
          const currentReturns = this.returns();
          const filteredReturns = currentReturns.filter(taxReturn => taxReturn.id !== id);
          this.returns.set(filteredReturns);
        } else {
          this.error.set(response.message || 'Failed to delete return');
        }
      }),
      map(response => response as ApiResponse<boolean>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to delete return');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  // ========== Return Processing ==========
  
  submitReturn(id: number): Observable<ApiResponse<TaxReturn>> {
    this.loading.set(true);
    
    return this.http.post<any>(`${this.apiUrl}/submit`, { return_id: id }).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          // Update local return status
          this.updateReturnStatus(id, 'submitted');
        } else {
          this.error.set(response.message || 'Failed to submit return');
        }
      }),
      map(response => response as ApiResponse<TaxReturn>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to submit return');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  amendReturn(id: number, reason: string): Observable<ApiResponse<TaxReturn>> {
    this.loading.set(true);
    
    return this.http.post<any>(`${this.apiUrl}/amend`, { 
      return_id: id, 
      reason: reason 
    }).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          // Update local return status
          this.updateReturnStatus(id, 'amended');
        } else {
          this.error.set(response.message || 'Failed to amend return');
        }
      }),
      map(response => response as ApiResponse<TaxReturn>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to amend return');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  // ========== Search and Filter Operations ==========
  
  searchReturns(query: string): TaxReturn[] {
    if (!query.trim()) return this.returns();
    
    const lowerQuery = query.toLowerCase();
    return this.returns().filter(taxReturn => 
      taxReturn.return_reference.toLowerCase().includes(lowerQuery) ||
      taxReturn.tax_type.toLowerCase().includes(lowerQuery) ||
      taxReturn.tax_year.includes(lowerQuery) ||
      taxReturn.tax_period.toLowerCase().includes(lowerQuery) ||
      taxReturn.acknowledgment_number?.toLowerCase().includes(lowerQuery)
    );
  }

  filterReturns(filters: SearchFilters): TaxReturn[] {
    let filtered = this.returns();
    
    if (filters.status) {
      filtered = filtered.filter(taxReturn => taxReturn.status === filters.status);
    }
    
    if (filters.dateFrom) {
      const fromDate = new Date(filters.dateFrom);
      filtered = filtered.filter(taxReturn => new Date(taxReturn.filing_date) >= fromDate);
    }
    
    if (filters.dateTo) {
      const toDate = new Date(filters.dateTo);
      filtered = filtered.filter(taxReturn => new Date(taxReturn.filing_date) <= toDate);
    }
    
    if (filters.type) {
      filtered = filtered.filter(taxReturn => 
        taxReturn.tax_type.toLowerCase().includes(filters.type!.toLowerCase())
      );
    }
    
    return filtered;
  }

  // ========== Utility Methods ==========
  
  getReturnById(id: number): TaxReturn | undefined {
    return this.returns().find(taxReturn => taxReturn.id === id);
  }

  getReturnsByStatus(status: string): TaxReturn[] {
    return this.returns().filter(taxReturn => taxReturn.status === status);
  }

  getReturnsByTaxType(taxType: string): TaxReturn[] {
    return this.returns().filter(taxReturn => 
      taxReturn.tax_type.toLowerCase() === taxType.toLowerCase()
    );
  }

  getReturnsByYear(year: string): TaxReturn[] {
    return this.returns().filter(taxReturn => taxReturn.tax_year === year);
  }

  getOverdueReturns(): TaxReturn[] {
    const today = new Date();
    return this.returns().filter(taxReturn => {
      const dueDate = new Date(taxReturn.due_date);
      return taxReturn.status !== 'accepted' && dueDate < today;
    });
  }

  exportToExcel(returns: TaxReturn[]): void {
    // Create CSV content
    const headers = [
      'Return Reference', 'Tax Type', 'Tax Year', 'Period', 'Filing Date', 
      'Due Date', 'Status', 'Total Income', 'Tax Payable', 'Tax Paid', 'Penalty', 'Refund'
    ];
    const rows = returns.map(taxReturn => [
      taxReturn.return_reference,
      taxReturn.tax_type,
      taxReturn.tax_year,
      taxReturn.tax_period,
      taxReturn.filing_date,
      taxReturn.due_date,
      taxReturn.status,
      taxReturn.total_income.toFixed(2),
      taxReturn.tax_payable.toFixed(2),
      taxReturn.tax_paid.toFixed(2),
      taxReturn.penalty.toFixed(2),
      taxReturn.refund.toFixed(2)
    ]);
    
    const csvContent = [headers, ...rows]
      .map(row => row.join(','))
      .join('\n');
    
    // Download file
    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `tax_returns_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    window.URL.revokeObjectURL(url);
  }

  printReturn(taxReturn: TaxReturn): void {
    // Create printable HTML
    const printContent = this.generatePrintableReturn(taxReturn);
    const printWindow = window.open('', '_blank');
    if (printWindow) {
      printWindow.document.write(printContent);
      printWindow.document.close();
      printWindow.print();
    }
  }

  // ========== Private Helper Methods ==========
  
  private updateReturnStatus(id: number, status: string): void {
    const currentReturns = this.returns();
    const updatedReturns = currentReturns.map(taxReturn => 
      taxReturn.id === id ? { ...taxReturn, status: status as any } : taxReturn
    );
    this.returns.set(updatedReturns);
  }

  private buildQueryParams(filters?: SearchFilters): string {
    if (!filters) return '';
    
    const params = new URLSearchParams();
    
    if (filters.query) params.append('search', filters.query);
    if (filters.dateFrom) params.append('date_from', filters.dateFrom);
    if (filters.dateTo) params.append('date_to', filters.dateTo);
    if (filters.status) params.append('status', filters.status);
    if (filters.type) params.append('type', filters.type);
    if (filters.limit) params.append('limit', filters.limit.toString());
    if (filters.offset) params.append('offset', filters.offset.toString());
    
    return params.toString();
  }

  private generateReturnReference(): string {
    const year = new Date().getFullYear();
    const month = String(new Date().getMonth() + 1).padStart(2, '0');
    const random = Math.floor(100000 + Math.random() * 900000);
    return `RET${year}${month}${random}`;
  }

  private generatePrintableReturn(taxReturn: TaxReturn): string {
    return `
      <!DOCTYPE html>
      <html>
      <head>
        <title>Tax Return - ${taxReturn.return_reference}</title>
        <style>
          body { font-family: Arial, sans-serif; margin: 20px; }
          .header { text-align: center; margin-bottom: 30px; }
          .return-details { margin-bottom: 20px; }
          .financial-details { margin-bottom: 20px; }
          .status { padding: 10px; border-radius: 5px; text-align: center; font-weight: bold; margin-bottom: 20px; }
          .draft { background-color: #fff3cd; color: #856404; }
          .submitted { background-color: #cce5ff; color: #004085; }
          .accepted { background-color: #d4edda; color: #155724; }
          .rejected { background-color: #f8d7da; color: #721c24; }
          .amended { background-color: #e2e3e5; color: #383d41; }
          .footer { margin-top: 30px; text-align: center; font-size: 12px; }
        </style>
      </head>
      <body>
        <div class="header">
          <h1>TAX RETURN</h1>
          <h2>${taxReturn.return_reference}</h2>
        </div>
        
        <div class="return-details">
          <p><strong>Tax Type:</strong> ${taxReturn.tax_type}</p>
          <p><strong>Tax Year:</strong> ${taxReturn.tax_year}</p>
          <p><strong>Tax Period:</strong> ${taxReturn.tax_period}</p>
          <p><strong>Filing Date:</strong> ${taxReturn.filing_date}</p>
          <p><strong>Due Date:</strong> ${taxReturn.due_date}</p>
          ${taxReturn.acknowledgment_number ? `<p><strong>Acknowledgment Number:</strong> ${taxReturn.acknowledgment_number}</p>` : ''}
        </div>
        
        <div class="financial-details">
          <p><strong>Total Income:</strong> KES ${taxReturn.total_income.toFixed(2)}</p>
          <p><strong>Tax Payable:</strong> KES ${taxReturn.tax_payable.toFixed(2)}</p>
          <p><strong>Tax Paid:</strong> KES ${taxReturn.tax_paid.toFixed(2)}</p>
          <p><strong>Penalty:</strong> KES ${taxReturn.penalty.toFixed(2)}</p>
          <p><strong>Interest:</strong> KES ${taxReturn.interest.toFixed(2)}</p>
          <p><strong>Refund:</strong> KES ${taxReturn.refund.toFixed(2)}</p>
        </div>
        
        <div class="status ${taxReturn.status}">
          STATUS: ${taxReturn.status.toUpperCase()}
        </div>
        
        <div class="footer">
          <p>This is a computer-generated tax return and requires no signature.</p>
          <p>KRA iTax Portal - Official Tax Return Record</p>
        </div>
      </body>
      </html>
    `;
  }

  // ========== State Management ==========
  
  clearError(): void {
    this.error.set(null);
  }

  refresh(): void {
    this.loadReturns();
  }

  resetState(): void {
    this.returns.set([]);
    this.error.set(null);
    this.loading.set(false);
    this.pagination.set({
      currentPage: 1,
      totalPages: 1,
      totalItems: 0,
      itemsPerPage: 10,
      hasNext: false,
      hasPrevious: false
    });
  }
}
