import { Injectable, inject, signal, computed } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Invoice, InvoiceItem, SearchFilters, PaginationInfo, ApiResponse } from '../models/enhanced.models';
import { Observable, of } from 'rxjs';
import { tap, map, catchError } from 'rxjs/operators';

@Injectable({
  providedIn: 'root'
})
export class EnhancedEtimsService {
  private http = inject(HttpClient);
  private apiUrl = 'http://localhost/itax/kra-api/etims_actions.php';
  
  // Signals for reactive state management
  private invoices = signal<Invoice[]>([]);
  private loading = signal(false);
  private error = signal<string | null>(null);
  private pagination = signal<PaginationInfo>({
    currentPage: 1,
    totalPages: 1,
    totalItems: 0,
    itemsPerPage: 10,
    hasNext: false,
    hasPrevious: false
  });
  
  // Computed values
  allInvoices = computed(() => this.invoices());
  isLoading = computed(() => this.loading());
  errorMessage = computed(() => this.error());
  paginationInfo = computed(() => this.pagination());
  
  // Filtered computed values
  syncedInvoices = computed(() => 
    this.invoices().filter(i => i.sync_status === 'synced')
  );
  pendingInvoices = computed(() => 
    this.invoices().filter(i => i.sync_status === 'pending')
  );
  failedInvoices = computed(() => 
    this.invoices().filter(i => i.sync_status === 'failed')
  );
  overdueInvoices = computed(() => 
    this.invoices().filter(i => 
      i.status === 'overdue' && new Date(i.due_date) < new Date()
    )
  );
  
  // Statistics
  totalRevenue = computed(() => 
    this.invoices().reduce((sum, i) => sum + i.total_amount, 0)
  );
  totalTax = computed(() => 
    this.invoices().reduce((sum, i) => sum + i.tax_amount, 0)
  );
  totalInvoicesCount = computed(() => this.invoices().length);
  syncedCount = computed(() => this.syncedInvoices().length);
  pendingCount = computed(() => this.pendingInvoices().length);
  failedCount = computed(() => this.failedInvoices().length);
  overdueCount = computed(() => this.overdueInvoices().length);

  constructor() {
    this.loadInvoices();
  }

  // ========== CRUD Operations ==========
  
  loadInvoices(filters?: SearchFilters): Observable<ApiResponse<Invoice[]>> {
    this.loading.set(true);
    this.error.set(null);
    
    const params = this.buildQueryParams(filters);
    
    return this.http.get<any>(`${this.apiUrl}?${params}`).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          this.invoices.set(response.data || []);
          if (response.pagination) {
            this.pagination.set(response.pagination);
          }
        } else {
          this.error.set(response.message || 'Failed to load invoices');
        }
      }),
      map(response => response as ApiResponse<Invoice[]>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to connect to server');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  createInvoice(invoiceData: Partial<Invoice>): Observable<ApiResponse<Invoice>> {
    this.loading.set(true);
    
    const payload = {
      ...invoiceData,
      invoice_number: this.generateInvoiceNumber(),
      status: 'draft',
      sync_status: 'pending',
      created_at: new Date().toISOString()
    };

    return this.http.post<any>(this.apiUrl, payload).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          // Refresh the invoice list
          this.loadInvoices();
        } else {
          this.error.set(response.message || 'Failed to create invoice');
        }
      }),
      map(response => response as ApiResponse<Invoice>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to create invoice');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  updateInvoice(id: number, updates: Partial<Invoice>): Observable<ApiResponse<Invoice>> {
    this.loading.set(true);
    
    return this.http.put<any>(`${this.apiUrl}?id=${id}`, updates).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          // Update local state
          const currentInvoices = this.invoices();
          const updatedInvoices = currentInvoices.map(inv => 
            inv.id === id ? { ...inv, ...updates } : inv
          );
          this.invoices.set(updatedInvoices);
        } else {
          this.error.set(response.message || 'Failed to update invoice');
        }
      }),
      map(response => response as ApiResponse<Invoice>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to update invoice');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  deleteInvoice(id: number): Observable<ApiResponse<boolean>> {
    this.loading.set(true);
    
    return this.http.delete<any>(`${this.apiUrl}?id=${id}`).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          // Remove from local state
          const currentInvoices = this.invoices();
          const filteredInvoices = currentInvoices.filter(inv => inv.id !== id);
          this.invoices.set(filteredInvoices);
        } else {
          this.error.set(response.message || 'Failed to delete invoice');
        }
      }),
      map(response => response as ApiResponse<boolean>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to delete invoice');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  // ========== eTIMS Sync Operations ==========
  
  syncToEtims(id: number): Observable<ApiResponse<Invoice>> {
    this.loading.set(true);
    
    return this.http.post<any>(`${this.apiUrl}/sync`, { invoice_id: id }).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          // Update local invoice status
          this.updateInvoiceStatus(id, 'synced');
        } else {
          this.error.set(response.message || 'Failed to sync to eTIMS');
        }
      }),
      map(response => response as ApiResponse<Invoice>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to sync to eTIMS');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  batchSync(invoiceIds: number[]): Observable<ApiResponse<Invoice[]>> {
    this.loading.set(true);
    
    return this.http.post<any>(`${this.apiUrl}/batch-sync`, { invoice_ids: invoiceIds }).pipe(
      tap(response => {
        this.loading.set(false);
        if (response.success) {
          // Refresh invoice list
          this.loadInvoices();
        } else {
          this.error.set(response.message || 'Failed to batch sync');
        }
      }),
      map(response => response as ApiResponse<Invoice[]>),
      catchError(error => {
        this.loading.set(false);
        this.error.set('Failed to batch sync');
        return of({ success: false, message: 'Connection error' });
      })
    );
  }

  // ========== Search and Filter Operations ==========
  
  searchInvoices(query: string): Invoice[] {
    if (!query.trim()) return this.invoices();
    
    const lowerQuery = query.toLowerCase();
    return this.invoices().filter(invoice => 
      invoice.invoice_number.toLowerCase().includes(lowerQuery) ||
      invoice.customer_name.toLowerCase().includes(lowerQuery) ||
      invoice.customer_tin?.toLowerCase().includes(lowerQuery) ||
      invoice.status.toLowerCase().includes(lowerQuery) ||
      invoice.items.some(item => 
        item.description.toLowerCase().includes(lowerQuery)
      )
    );
  }

  filterInvoices(filters: SearchFilters): Invoice[] {
    let filtered = this.invoices();
    
    if (filters.status) {
      filtered = filtered.filter(inv => inv.status === filters.status);
    }
    
    if (filters.dateFrom) {
      const fromDate = new Date(filters.dateFrom);
      filtered = filtered.filter(inv => new Date(inv.invoice_date) >= fromDate);
    }
    
    if (filters.dateTo) {
      const toDate = new Date(filters.dateTo);
      filtered = filtered.filter(inv => new Date(inv.invoice_date) <= toDate);
    }
    
    if (filters.type) {
      filtered = filtered.filter(inv => 
        inv.items.some(item => item.description.toLowerCase().includes(filters.type!.toLowerCase()))
      );
    }
    
    return filtered;
  }

  // ========== Utility Methods ==========
  
  getInvoiceById(id: number): Invoice | undefined {
    return this.invoices().find(inv => inv.id === id);
  }

  getInvoicesByStatus(status: string): Invoice[] {
    return this.invoices().filter(inv => inv.status === status);
  }

  getInvoicesByDateRange(startDate: string, endDate: string): Invoice[] {
    const start = new Date(startDate);
    const end = new Date(endDate);
    
    return this.invoices().filter(inv => {
      const invDate = new Date(inv.invoice_date);
      return invDate >= start && invDate <= end;
    });
  }

  exportToExcel(invoices: Invoice[]): void {
    // Create CSV content
    const headers = ['Invoice Number', 'Customer Name', 'Date', 'Due Date', 'Amount', 'Tax', 'Total', 'Status'];
    const rows = invoices.map(inv => [
      inv.invoice_number,
      inv.customer_name,
      inv.invoice_date,
      inv.due_date,
      inv.subtotal.toFixed(2),
      inv.tax_amount.toFixed(2),
      inv.total_amount.toFixed(2),
      inv.status
    ]);
    
    const csvContent = [headers, ...rows]
      .map(row => row.join(','))
      .join('\n');
    
    // Download file
    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `invoices_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    window.URL.revokeObjectURL(url);
  }

  printInvoice(invoice: Invoice): void {
    // Create printable HTML
    const printContent = this.generatePrintableInvoice(invoice);
    const printWindow = window.open('', '_blank');
    if (printWindow) {
      printWindow.document.write(printContent);
      printWindow.document.close();
      printWindow.print();
    }
  }

  // ========== Private Helper Methods ==========
  
  private updateInvoiceStatus(id: number, status: string): void {
    const currentInvoices = this.invoices();
    const updatedInvoices = currentInvoices.map(inv => 
      inv.id === id ? { ...inv, sync_status: status as any } : inv
    );
    this.invoices.set(updatedInvoices);
  }

  private buildQueryParams(filters?: SearchFilters): string {
    if (!filters) return '';
    
    const params = new URLSearchParams();
    
    if (filters.query) params.append('search', filters.query);
    if (filters.dateFrom) params.append('date_from', filters.dateFrom);
    if (filters.dateTo) params.append('date_to', filters.dateTo);
    if (filters.status) params.append('status', filters.status);
    if (filters.type) params.append('type', filters.type);
    if (filters.limit) params.append('limit', filters.limit.toString());
    if (filters.offset) params.append('offset', filters.offset.toString());
    
    return params.toString();
  }

  private generateInvoiceNumber(): string {
    const year = new Date().getFullYear();
    const month = String(new Date().getMonth() + 1).padStart(2, '0');
    const random = Math.floor(1000 + Math.random() * 9000);
    return `INV${year}${month}${random}`;
  }

  private generatePrintableInvoice(invoice: Invoice): string {
    const items = invoice.items.map(item => `
      <tr>
        <td>${item.description}</td>
        <td>${item.quantity}</td>
        <td>KES ${item.unit_price.toFixed(2)}</td>
        <td>KES ${item.amount.toFixed(2)}</td>
      </tr>
    `).join('');

    return `
      <!DOCTYPE html>
      <html>
      <head>
        <title>Invoice ${invoice.invoice_number}</title>
        <style>
          body { font-family: Arial, sans-serif; margin: 20px; }
          .header { text-align: center; margin-bottom: 30px; }
          .invoice-details { margin-bottom: 20px; }
          .items-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
          .items-table th, .items-table td { border: 1px solid #ddd; padding: 8px; text-align: left; }
          .items-table th { background-color: #f2f2f2; }
          .totals { text-align: right; margin-top: 20px; }
          .footer { margin-top: 30px; text-align: center; font-size: 12px; }
        </style>
      </head>
      <body>
        <div class="header">
          <h1>TAX INVOICE</h1>
          <h2>${invoice.invoice_number}</h2>
        </div>
        
        <div class="invoice-details">
          <p><strong>Customer:</strong> ${invoice.customer_name}</p>
          <p><strong>Date:</strong> ${invoice.invoice_date}</p>
          <p><strong>Due Date:</strong> ${invoice.due_date}</p>
          ${invoice.customer_tin ? `<p><strong>Customer TIN:</strong> ${invoice.customer_tin}</p>` : ''}
        </div>
        
        <table class="items-table">
          <thead>
            <tr>
              <th>Description</th>
              <th>Quantity</th>
              <th>Unit Price</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody>
            ${items}
          </tbody>
        </table>
        
        <div class="totals">
          <p><strong>Subtotal:</strong> KES ${invoice.subtotal.toFixed(2)}</p>
          <p><strong>Tax (${(invoice.tax_rate * 100).toFixed(1)}%):</strong> KES ${invoice.tax_amount.toFixed(2)}</p>
          <p><strong>Total:</strong> KES ${invoice.total_amount.toFixed(2)}</p>
        </div>
        
        <div class="footer">
          <p>This is a computer-generated invoice and requires no signature.</p>
          <p>KRA iTax Portal - eTIMS Integrated</p>
        </div>
      </body>
      </html>
    `;
  }

  // ========== State Management ==========
  
  clearError(): void {
    this.error.set(null);
  }

  refresh(): void {
    this.loadInvoices();
  }

  resetState(): void {
    this.invoices.set([]);
    this.error.set(null);
    this.loading.set(false);
    this.pagination.set({
      currentPage: 1,
      totalPages: 1,
      totalItems: 0,
      itemsPerPage: 10,
      hasNext: false,
      hasPrevious: false
    });
  }
}
